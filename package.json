{
  "name": "tars-agent",
  "version": "1.0.0",
  "private": true,
  "description": "TARS autonomous AI computer agent for Windows",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -p tsconfig.electron.json && vite build && electron-builder",
    "build:web": "vite build",
    "lint": "tsc -p tsconfig.electron.json --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron .",
    "dist": "npm run build",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.2",
    "electron-log": "^5.2.0",
    "electron-store": "^10.0.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "playwright": "^1.55.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "screenshot-desktop": "^1.15.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.tars.agent",
    "productName": "TARS",
    "asar": true,
    "files": ["dist", "dist-electron", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "artifactName": "TARS-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
